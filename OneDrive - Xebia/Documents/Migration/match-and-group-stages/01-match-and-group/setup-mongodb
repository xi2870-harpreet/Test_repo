## Template for creating a challenge setup script
## Important: double check your logic as every unit is slighly different
source /scripts/lib.sh
setup_challenge

# Wait for Instruqt to finish booting
if ! is_local_mode; then
  while [ ! -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
    echo "Waiting for Instruqt to finish booting the virtual machine"
    sleep 1
  done
  set-workdir /lab
fi

# Create lab directory
mkdir -p /lab
mkdir -p /root/.mongodb/mongosh

# Ensure compatibility with local track runner
is_local_mode && mkdir -p /opt/instruqt/bootstrap
is_local_mode && set_var AGENT_VARS_FILE

# S3 stuff
install_aws_cli
pull_and_extract "s3://mdb-edu-curriculum/labs/${INSTRUQT_TRACK_SLUG}.tgz"

# Extract embedded files
extract_embedded_files_with_defaults

# Source lib, local mongod and dataset helpers
source /scripts/lib.sh
source /scripts/local_mongod.sh

# Set dbuser/passwords as environment variables (DB_USER_<username>, DB_PASS_<username>, DB_CREDS_<username>)
set_username_and_pass mdb_admin "$(gen_password)"
set_username_and_pass mdb_student "$(gen_password)"

# Set other variables
set_var DB_NAME "bird_data"
set_var COLLECTION_NAME "sightings"
set_var NS "${DB_NAME}.${COLLECTION_NAME}" # used in assignment.md
set_var SOLVED_DIR "/app/${INSTRUQT_TRACK_SLUG}/solved/${CHALLENGE_IDX}"
set_var COMMON_DIR "/app/${INSTRUQT_TRACK_SLUG}/common"
set_var DATASET_PATH "/sampledata/${DB_NAME}.${COLLECTION_NAME}.json"
set_var SOLVE_SCRIPT "${SOLVED_DIR}/solve.js"

# Set connection strings
set_local_connection_string $DB_CREDS_MDB_STUDENT $DB_NAME
set_local_admin_cs $DB_CREDS_MDB_ADMIN

yq e '.processManagement.fork = true' -i /etc/mongod.conf

# Enable authentication and start mongod
enable_authentication
start_mongod

# Create db users
create_admin_user -u $DB_USER_MDB_ADMIN -p $DB_PASS_MDB_ADMIN
create_db_user -u $DB_USER_MDB_STUDENT -p $DB_PASS_MDB_STUDENT -d $DB_NAME

# Import the sampledata
mongoimport $CONNECTION_STRING --file $DATASET_PATH --db $DB_NAME --collection "$COLLECTION_NAME"
  
configure_welcome_message

exit 0
